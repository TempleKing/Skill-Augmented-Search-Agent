# Copy to .env and set LLM_API_KEY locally, or export it in your shell.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=0
LLM_TIMEOUT=1800
LLM_MAX_RETRIES=2
LLM_ENABLE_THINKING=true
LLM_REASONING_EFFORT=high
LLM_THINKING_ROUNDS=10
LLM_ENABLE_QUERY_PLANNER=true
LLM_PLANNER_MAX_TOKENS=0

CORPUS_PATH=./data/corpus
BM25_DB_PATH=./indexes/bm25_full.sqlite
RETRIEVAL_METHOD=bm25
# Retrieval modes: bm25, bm25_bge, bm25_qwen, bm25_bge_qwen.
RETRIEVAL_MODE=bm25
BGE_INDEX_PATH=./indexes/experimental_bge
BGE_MODEL_PATH=./models/bge-small-en-v1.5
BGE_DEVICE=cpu
QWEN_INDEX_PATH=./indexes/experimental_qwen
QWEN_MODEL_PATH=./models/qwen3-embedding-0.6b
QWEN_DEVICE=cpu
HYBRID_CANDIDATE_K=50
HYBRID_RRF_K=60
HYBRID_BM25_WEIGHT=1
HYBRID_BGE_WEIGHT=1
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATE_K=50
RETRIEVAL_RRF_K=60

MAX_READ_CHARS=4000
MAX_MATCHES=10
MAX_CONTEXT_CHARS=500
MAX_AGENT_STEPS=10
MAX_TOOL_CALLS=15
MAX_TOTAL_TOKENS_PER_RUN=95000
MIN_REMAINING_TOKENS_FOR_LLM_CALL=10000
MAX_STALLED_SEARCHES=3
MAX_REPEATED_CANDIDATES=2
SKILLS_PATH=./skills
LOG_LEVEL=INFO
